# Copy this file to .env.local (already gitignored) and fill in real values.

VITE_API_BASE_URL=https://reconflow-ai.onrender.com

# The PRODUCTION URL of the "Run Reconciliation" Form Trigger node - only
# live once that workflow is toggled Active in n8n. The Test URL (visible
# while the workflow is open in the editor) only fires once per click of
# "Listen for test event" and will look broken here otherwise.
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/form/6d7c1aeb-87f9-4ec9-af24-4cf86435bc94
